graph global {
  meta: { description: "Global styles", type: "core", output: "CSS styles" }

  let reset = injectCSS(id: "globalReset", css: "* { margin: 0; padding: 0; box-sizing: border-box; } body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; color: #333; line-height: 1.5; background: #fff; }")
  let windowStyles = injectCSS(id: "globalWindow", css: ".window-btn { width: 46px; height: 32px; border: none; background: transparent; cursor: default; font-size: 12px; color: #666; transition: background 0.15s ease, color 0.15s ease; } .window-btn:hover { background: #e5e5e5; color: #333; } .window-btn:active { background: #d0d0d0; } .window-btn-close:hover { background: #e81123; color: #fff; }")
  let toolbarStyles = injectCSS(id: "globalToolbar", css: ".toolbar-btn { width: 36px; height: 36px; border: none; background: transparent; cursor: default; font-size: 16px; border-radius: 6px; color: #666; transition: background 0.15s ease, color 0.15s ease; } .toolbar-btn:hover { background: #e0e0e0; color: #333; } .toolbar-btn:active { background: #d0d0d0; }")
  let sidebarStyles = injectCSS(id: "globalSidebar", css: ".sidebar-item { padding: 12px 16px; cursor: default; border-radius: 0px; transition: background 0.15s ease; } .sidebar-item:hover { background: #f0f0f0; } .sidebar-item.active { background: #e5e5e5; }")
  let btnStyles = injectCSS(id: "globalButtons", css: ".btn-primary { padding: 8px 16px; border: none; border-radius: 6px; background: #007aff; color: #fff; cursor: default; font-size: 14px; outline: none; transition: background 0.15s ease; } .btn-primary:hover { background: #0066d6; } .btn-secondary { padding: 8px 16px; border: 1px solid #e5e5e5; border-radius: 6px; background: #fff; color: #333; cursor: default; font-size: 14px; transition: background 0.15s ease; } .btn-secondary:hover { background: #f5f5f5; }")
  let overlayStyles = injectCSS(id: "globalOverlay", css: ".overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); display: flex; align-items: center; justify-content: center; z-index: 1000; }")
}
