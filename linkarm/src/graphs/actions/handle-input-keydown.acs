graph handle-input-keydown {
  meta: { description: "Handle input keydown - Enter to send, Shift+Enter for newline", type: "core", input: "inputKeydown_key, inputKeydown_shiftKey" }

  // Explicit data flow: read the dedicated keys provided by addEventListener
  let getKey = get(key: "inputKeydown_key")
  let getShiftKey = get(key: "inputKeydown_shiftKey")
  let isEnter = eq(a: "{{getKey}}", b: "Enter")
  let isNotShift = not(value: "{{getShiftKey}}")
  let shouldSend = and(a: "{{isEnter}}", b: "{{isNotShift}}")
  let handleSend = if shouldSend {
    let sendMessage = execFile(file: "actions/send-message")
  }
}
