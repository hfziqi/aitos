graph copy-message {
  meta: { description: "Copy message content to clipboard", type: "core", input: "clickTargetId, messages", output: "copy button icon DOM" }

  let getTargetId = get(key: "clickTargetId")
  let getMsgIndexStr = slice(array: "{{getTargetId}}", start: 8)
  let msgIndex = toNum(value: "{{getMsgIndexStr}}")
  let getMessages = get(key: "messages")
  let getTargetMsg = getAt(array: "{{getMessages}}", index: "{{msgIndex}}")
  let getMsgContent = getProp(obj: "{{getTargetMsg}}", key: "content")
  let copyResult = copyToClipboard(text: "{{getMsgContent}}")
  let copySuccess = get(key: "copyResult_success")
  let handleFeedback = if copySuccess {
    let setCopiedIcon = setInnerHTML(id: "{{getTargetId}}", html: "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"pointer-events:none\"><polyline points=\"20 6 9 17 4 12\"></polyline></svg>")
  }
}