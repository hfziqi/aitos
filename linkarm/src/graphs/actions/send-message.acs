graph send-message {
  meta: { description: "Send user message and trigger AI response (supports attachments)", type: "core", input: "_uploadedFile", output: "newMessage, _pendingFileContent, _titleMsg, userMessage, streamElementId" }

  let getInputValue = getValue(id: "inputBox")
  let getUploadedFile = get(key: "_uploadedFile")
  let canSend = or(a: {{getInputValue}}, b: {{getUploadedFile}})
  let diagCanSend = log(message: "MSG_DIAG canSend", data: "{{canSend}}")
  
  if canSend {
    let noAttachment = isNil(value: "{{getUploadedFile}}")
    let buildUserMessage = if noAttachment {
      let setMsgObj = set(key: "_userMessageObj", value: { role: "user", content: {{getInputValue}}, timestamp: "now" })
    } else {
      let readFileData = readFile(file: "{{getUploadedFile}}", encoding: "dataURL")
      let readAsText = readFile(file: "{{getUploadedFile}}", encoding: "text")
      let fileLabel = concat(a: "\n\n--- ", b: "{{getUploadedFile.name}}")
      let fileLabel2 = concat(a: "{{fileLabel}}", b: " ---\n")
      let fullContent = concat(a: "{{fileLabel2}}", b: "{{readAsText}}")
      let savePending = set(key: "_pendingFileContent", value: "{{fullContent}}")
      let setMsgObj = set(key: "_userMessageObj", value: { role: "user", content: {{getInputValue}}, attachments: [{ name: "{{getUploadedFile.name}}", type: "{{getUploadedFile.type}}", data: "{{readFileData}}" }], timestamp: "now" })
    }
    
    let setNewMessage = set(key: "newMessage", value: {{buildUserMessage}})
    let addUserMessageToConversation = execFile(file: "messages/add-message")
    let clearInput = setValue(id: "inputBox", value: "")
    let removePreview = removeElement(id: "attachPreviewBar")
    let clearAttachment = set(key: "_uploadedFile", value: null)
    let appendBubble = execFile(file: "ui/views/chat/append-message")
    let saveTitleInput = set(key: "_titleMsg", value: "{{getInputValue}}")
    let updateTitle = execFile(file: "conversations/update-title")
    let refreshSidebar = executeInContext(contextKey: "_activeContext", graphKey: "__graph_ui/layout/sidebar/update")
    let createStreamContainer = execFile(file: "ui/components/stream-container/create")
    let prepareAICall = set(key: "userMessage", value: {{getInputValue}})
    let diagBeforeAI = log(message: "MSG_DIAG about to call call-ai-response", data: "{{getInputValue}}")
    let callAIResponse = execFile(file: "services/ai/call-ai-response")
  }
}
