graph create {
  meta: { description: "Create sidebar container (logic)", type: "core", input: "conversations, currentConversationId", output: "sidebar DOM" }

  let checkSidebarContainer = getElementById(domId: "sidebarContainer", storeId: "existingSidebar")
  let shouldCreateSidebar = not(value: "{{checkSidebarContainer}}")
  let branchSidebarContainer = if shouldCreateSidebar {
    let createSidebarContainer = createElement(tag: "div", id: "sidebarContainer")
    let setLayoutStyles = setStyles(id: "sidebarContainer", styles: { display: "flex", flexDirection: "column", height: "100%", minHeight: "0" })
    let execStyles = execFile(file: "ui/layout/sidebar/styles")
    let appendSidebarContainer = appendChild(parentId: "mainContent", childId: "sidebarContainer")
  }
  let clearSidebar = clearElement(id: "sidebarContainer")
  let createNewChatButton = createElement(tag: "button", id: "newChatButton")
  let setNewChatButtonClass = setAttribute(id: "newChatButton", name: "class", value: "btn-primary")
  let setNewChatButtonCustomStyles = setStyles(id: "newChatButton", styles: { display: "flex", alignItems: "center", justifyContent: "center", gap: "8px", margin: "22px 18px 8px 18px", padding: "8px 20px", backgroundColor: "#4caf50", color: "#fff", border: "none", borderRadius: "4px", fontSize: "18px", fontWeight: "200", cursor: "default" })
  let setNewChatButtonIcon = setInnerHTML(id: "newChatButton", html: "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\"><line x1=\"12\" y1=\"5\" x2=\"12\" y2=\"19\"/><line x1=\"5\" y1=\"12\" x2=\"19\" y2=\"12\"/></svg>")
  let appendNewChatButton = appendChild(parentId: "sidebarContainer", childId: "newChatButton")
  let createConvList = createElement(tag: "div", id: "conversationList")
  let setConvListStyles = setStyles(id: "conversationList", styles: { flex: "1", overflowY: "auto", minHeight: "0" })
  let appendConvList = appendChild(parentId: "sidebarContainer", childId: "conversationList")
  let getConversations = get(key: "conversations")
  let getCurrentConvId = get(key: "currentConversationId")
  let forEachConversation = forEach conversation, convIndex in getConversations  {
    let createConvItem = createElement(tag: "div", id: "convItem-{{convIndex}}")
    let getConvId = getProp(obj: "{{conversation}}", key: "id")
    let isActive = eq(a: "{{getConvId}}", b: "{{getCurrentConvId}}")
    let setConvItemClass = if isActive {
      let setActiveClass = setAttribute(id: "convItem-{{convIndex}}", name: "class", value: "sidebar-item active")
    } else {
      let setNormalClass = setAttribute(id: "convItem-{{convIndex}}", name: "class", value: "sidebar-item")
    }
    let setConvItemStyles = setStyles(id: "convItem-{{convIndex}}", styles: { display: "flex", justifyContent: "space-between", alignItems: "center", position: "relative" })
    let setConvItemId = setAttribute(id: "convItem-{{convIndex}}", name: "data-conv-id", value: "{{getConvId}}")
    let createTitleSpan = createElement(tag: "span", id: "convTitle-{{convIndex}}")
    let getConvTitle = getProp(obj: "{{conversation}}", key: "title")
    let setConvTitleAttr = setAttribute(id: "convItem-{{convIndex}}", name: "data-conv-title", value: "{{getConvTitle}}")
    let setTitleText = setTextContent(id: "convTitle-{{convIndex}}", text: "{{getConvTitle}}")
    let setTitleStyles = setStyles(id: "convTitle-{{convIndex}}", styles: { overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap", flex: "1", minWidth: "0", fontSize: "15px" })
    let appendTitleSpan = appendChild(parentId: "convItem-{{convIndex}}", childId: "convTitle-{{convIndex}}")
    let appendConvItem = appendChild(parentId: "conversationList", childId: "convItem-{{convIndex}}")
  }
  let listenContextMenu = addEventListener(id: "conversationList", event: "contextmenu", storeKey: "_contextMenuEvent", action: "ui/components/context-menu/conv-show", preventDefault: true)
}