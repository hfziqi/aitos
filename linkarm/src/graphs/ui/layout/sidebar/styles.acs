graph styles {
  meta: { description: "Sidebar appearance styles", type: "core", output: "CSS styles" }

  let getSideW = get(key: "sideW")
  let setAppearanceStyles = setStyles(id: "sidebarContainer", styles: { width: "{{getSideW}}px", backgroundColor: "#fcfcfc", borderRight: "1px solid #e0e0e0" })
  let injectScrollbarStyles = injectCSS(id: "sidebarScrollbarHide", css: "#conversationList { scrollbar-width: none; } #conversationList::-webkit-scrollbar { display: none; }")
}