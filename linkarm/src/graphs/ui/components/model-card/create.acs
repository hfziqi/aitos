graph create {
  meta: { description: "Create model card for grid layout with actions", type: "core", input: "currentModel, activeModelId", output: "model card DOM" }

  let getCurrentModel = get(key: "currentModel")
  let getModelId = getProp(obj: "{{getCurrentModel}}", key: "id")
  let getModelName = getProp(obj: "{{getCurrentModel}}", key: "name")
  let getActiveModelId = get(key: "activeModelId")
  let isSelected = eq(a: "{{getModelId}}", b: "{{getActiveModelId}}")
  let createCardId = concat(a: "model_card_", b: "{{getModelId}}")
  let createCard = createElement(tag: "div", id: "{{createCardId}}")
  let setDataModelId = setAttribute(id: "{{createCardId}}", name: "data-model-id", value: "{{getModelId}}")
  let setCardClass = if isSelected {
    let setSelectedClass = setAttribute(id: "{{createCardId}}", name: "class", value: "model-card selected")
  } else {
    let setNormalClass = setAttribute(id: "{{createCardId}}", name: "class", value: "model-card")
  }
  let createIcon = createElement(tag: "div", id: "{{createCardId}}_icon")
  let setIconClass = setAttribute(id: "{{createCardId}}_icon", name: "class", value: "model-card-icon")
  let getModelLogo = getProp(obj: "{{getCurrentModel}}", key: "logo")
  let checkLogoNil = isNil(value: "{{getModelLogo}}")
  let renderLogo = if checkLogoNil {
    let getModelIcon = getProp(obj: "{{getCurrentModel}}", key: "icon")
    let checkIconNil = isNil(value: "{{getModelIcon}}")
    let renderIcon = if checkIconNil {
      let setDefaultIcon = setTextContent(id: "{{createCardId}}_icon", text: "🤖")
    } else {
      let setModelIcon = setTextContent(id: "{{createCardId}}_icon", text: "{{getModelIcon}}")
    }
  } else {
    let setLogoImg = setInnerHTML(id: "{{createCardId}}_icon", html: "<img src=\"{{getModelLogo}}\" style=\"width:32px;height:32px;border-radius:8px;object-fit:cover\" alt=\"\">")
  }
  let createName = createElement(tag: "div", id: "{{createCardId}}_name")
  let setNameClass = setAttribute(id: "{{createCardId}}_name", name: "class", value: "model-card-name")
  let setNameText = setTextContent(id: "{{createCardId}}_name", text: "{{getModelName}}")
  let appendCard = appendChild(parentId: "modelsGrid", childId: "{{createCardId}}")
  let appendIcon = appendChild(parentId: "{{createCardId}}", childId: "{{createCardId}}_icon")
  let appendName = appendChild(parentId: "{{createCardId}}", childId: "{{createCardId}}_name")
}
