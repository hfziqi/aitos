graph create {
  meta: { description: "Create attachment preview bar inside chat input", type: "core", input: "_uploadedFile", output: "attachment preview DOM" }

  let getFile = get(key: "_uploadedFile")
  let isFileNil = isNil(value: "{{getFile}}")
  let fileExists = not(value: "{{isFileNil}}")
  if fileExists {
    let createPreviewBar = createElement(tag: "span", id: "attachPreviewBar")
    let setBarStyle = setStyles(id: "attachPreviewBar", styles: { display: "inline-flex", alignItems: "center", gap: "4px", flexShrink: "0" })
    let createFileIcon = createElement(tag: "span", id: "attachFileIcon")
    let setIconStyle = setStyles(id: "attachFileIcon", styles: { fontSize: "12px", flexShrink: "0" })
    let setIconDefault = setTextContent(id: "attachFileIcon", text: "📄")
    let appendIcon = appendChild(parentId: "attachPreviewBar", childId: "attachFileIcon")
    let createFileInfo = createElement(tag: "span", id: "attachFileInfo")
    let setInfoStyle = setStyles(id: "attachFileInfo", styles: { fontSize: "12px", color: "#007aff", overflow: "hidden", textOverflow: "ellipsis", whiteSpace: "nowrap", maxWidth: "120px" })
    let getFileName = getProp(obj: "{{getFile}}", key: "name")
    let setFileName = setTextContent(id: "attachFileInfo", text: "{{getFileName}}")
    let appendInfo = appendChild(parentId: "attachPreviewBar", childId: "attachFileInfo")
    let createRemoveBtn = createElement(tag: "button", id: "removeAttachBtn")
    let setRemoveStyle = setStyles(id: "removeAttachBtn", styles: { border: "none", background: "transparent", fontSize: "12px", cursor: "pointer", color: "#999", padding: "0 2px", flexShrink: "0", lineHeight: "1", display: "inline-flex", alignItems: "center", justifyContent: "center", width: "16px", height: "16px", borderRadius: "50%" })
    let setRemoveText = setTextContent(id: "removeAttachBtn", text: "✕")
    let appendRemove = appendChild(parentId: "attachPreviewBar", childId: "removeAttachBtn")
    let appendToRow = appendChild(parentId: "inputRow", childId: "attachPreviewBar")
  }
}
