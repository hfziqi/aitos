graph styles {
  meta: { description: "Chat input appearance styles", type: "core", output: "CSS styles" }

  let injectStyles = injectCSS(id: "chatInputStyles", css: ".chat-input-container { display: flex; flex-direction: column; flex-shrink: 0; width: 100%; padding: 0 24px 16px 24px; box-sizing: border-box; align-items: center; } .chat-input-inner { display: flex; flex-direction: column; flex: 1; max-width: 680px; width: 100%; background-color: #f1f1f1; border: 1px solid #c8c8c8; border-radius: 20px; padding: 16px 16px 12px 16px; min-height: 56px; } .chat-input-row { display: flex; flex-direction: row; align-items: flex-end; gap: 8px; flex: 1; } .chat-input-box { flex: 1; border: none; outline: none; resize: none; font-size: 14px; line-height: 1.4; min-height: 28px; max-height: 120px; padding: 0 8px; background-color: transparent; box-sizing: border-box; overflow: hidden; } .chat-input-send-btn { width: 32px; height: 32px; min-width: 32px; min-height: 32px; border-radius: 50%; background-color: #4caf50; color: #fff; border: none; display: flex; align-items: center; justify-content: center; cursor: default; flex-shrink: 0; } .chat-input-send-btn.disabled { background-color: #d0d0d0; color: #aaa; } .chat-input-upload-btn { width: 32px; height: 32px; min-width: 32px; min-height: 32px; border-radius: 50%; background-color: transparent; color: #999; border: none; display: flex; align-items: center; justify-content: center; cursor: default; flex-shrink: 0; } .chat-input-upload-btn:hover::before { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 24px; height: 24px; border-radius: 6px; background-color: rgba(0,0,0,0.08); z-index: -1; }")
}
