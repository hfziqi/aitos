graph create {
  meta: { description: "Create chat input area (logic)", type: "core", output: "chat input DOM" }

  let createInputContainer = createElement(tag: "div", id: "inputContainer")
  let setContainerClass = setAttribute(id: "inputContainer", name: "class", value: "chat-input-container")
  let appendInputContainer = appendChild(parentId: "mainViewContainer", childId: "inputContainer")
  let createInnerWrapper = createElement(tag: "div", id: "inputInnerWrapper")
  let setInnerClass = setAttribute(id: "inputInnerWrapper", name: "class", value: "chat-input-inner")
  let appendInnerWrapper = appendChild(parentId: "inputContainer", childId: "inputInnerWrapper")
  let createInputRow = createElement(tag: "div", id: "inputRow")
  let setInputRowClass = setAttribute(id: "inputRow", name: "class", value: "chat-input-row")
  let appendInputRow = appendChild(parentId: "inputInnerWrapper", childId: "inputRow")
  let createInputBox = createElement(tag: "textarea", id: "inputBox")
  let setInputBoxClass = setAttribute(id: "inputBox", name: "class", value: "chat-input-box")
  let appendInputBox = appendChild(parentId: "inputRow", childId: "inputBox")
  let createUploadBtn = createElement(tag: "button", id: "uploadBtn")
  let setUploadBtnClass = setAttribute(id: "uploadBtn", name: "class", value: "chat-input-upload-btn")
  let setUploadBtnIcon = setInnerHTML(id: "uploadBtn", html: "<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"transform: rotate(-45deg);\"><path d=\"M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48\"/></svg>")
  let appendUploadBtn = appendChild(parentId: "inputRow", childId: "uploadBtn")
  let createSendButton = createElement(tag: "button", id: "sendButton")
  let setSendButtonClass = setAttribute(id: "sendButton", name: "class", value: "chat-input-send-btn disabled")
  let setSendButtonIcon = setInnerHTML(id: "sendButton", html: "<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z\"/></svg>")
  let appendSendButton = appendChild(parentId: "inputRow", childId: "sendButton")
  let listenInput = addEventListener(id: "inputBox", event: "input", storeKey: "inputValue", action: "actions/handle-input-change")
  let listenKeydown = addEventListener(id: "inputBox", event: "keydown", storeKey: "inputKeydown", action: "actions/handle-input-keydown", preventDefault: true)
}
