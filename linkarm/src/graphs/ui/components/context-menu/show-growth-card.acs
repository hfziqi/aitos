graph show-growth-card {
  meta: { description: "Context menu items for growth card - Lock/Unlock, Delete", type: "core", input: "_contextMenuGrowthIndex, growthsListResult", output: "_contextMenuGrowthName, context menu DOM" }

  let readGrowthIndex = execFile(file: "growth/list-growths")
  let getGrowths = get(key: "growthsListResult")
  let getGrowthIndex = get(key: "_contextMenuGrowthIndex")
  let growthsIsArr = isArr(value: "{{getGrowths}}")
  let handleArr = if growthsIsArr {
    let getCardNum = toNum(value: "{{getGrowthIndex}}")
    let getGrowthItem = getAt(array: "{{getGrowths}}", index: {{getCardNum}})
    let getGrowthName = getProp(obj: "{{getGrowthItem}}", key: "name")
    let saveGrowthName = set(key: "_contextMenuGrowthName", value: "{{getGrowthName}}")
    let setLockCheckName = set(key: "name", value: "{{getGrowthName}}")
    let execCheckLock = execFile(file: "growth/check-lock")
    let getLockResult = get(key: "checkLockResult")
    let getLocked = getProp(obj: "{{getLockResult}}", key: "locked")
    let showLockItems = if getLocked {
      let createUnlockItem = createElement(tag: "div", id: "contextMenuUnlockBtn")
      let setUnlockStyles = setStyles(id: "contextMenuUnlockBtn", styles: { padding: "8px 16px", fontSize: "14px", cursor: "default", color: "#333", display: "flex", alignItems: "center", gap: "8px" })
      let setUnlockClass = setAttribute(id: "contextMenuUnlockBtn", name: "class", value: "context-menu-item")
      let setUnlockText = setTextContent(id: "contextMenuUnlockBtn", text: "🔓 Unlock")
      let appendUnlock = appendChild(parentId: "contextMenu", childId: "contextMenuUnlockBtn")
    } else {
      let createLockItem = createElement(tag: "div", id: "contextMenuLockBtn")
      let setLockStyles = setStyles(id: "contextMenuLockBtn", styles: { padding: "8px 16px", fontSize: "14px", cursor: "default", color: "#333", display: "flex", alignItems: "center", gap: "8px" })
      let setLockClass = setAttribute(id: "contextMenuLockBtn", name: "class", value: "context-menu-item")
      let setLockText = setTextContent(id: "contextMenuLockBtn", text: "🔒 Lock")
      let appendLock = appendChild(parentId: "contextMenu", childId: "contextMenuLockBtn")
    }
    let createDelItem = createElement(tag: "div", id: "contextMenuGrowthDelete")
    let setDelStyles = setStyles(id: "contextMenuGrowthDelete", styles: { padding: "8px 16px", fontSize: "14px", cursor: "default", color: "#d32f2f", display: "flex", alignItems: "center", gap: "8px" })
    let setDelClass = setAttribute(id: "contextMenuGrowthDelete", name: "class", value: "context-menu-item")
    let setDelText = setTextContent(id: "contextMenuGrowthDelete", text: "❌ Delete")
    let appendDel = appendChild(parentId: "contextMenu", childId: "contextMenuGrowthDelete")
  }
}
