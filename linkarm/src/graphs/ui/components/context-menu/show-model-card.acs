graph show-model-card {
  meta: { description: "Context menu items for model card - Delete", type: "component", category: "context-menu", author: "AITOS Team" }

  let createDelItem = createElement(tag: "div", id: "contextMenuModelDelete")
  let setDelStyles = setStyles(id: "contextMenuModelDelete", styles: { padding: "8px 16px", fontSize: "14px", cursor: "default", color: "#d32f2f", display: "flex", alignItems: "center", gap: "8px" })
  let setDelClass = setAttribute(id: "contextMenuModelDelete", name: "class", value: "context-menu-item")
  let setDelText = setTextContent(id: "contextMenuModelDelete", text: "❌ Delete")
  let appendDel = appendChild(parentId: "contextMenu", childId: "contextMenuModelDelete")
}
