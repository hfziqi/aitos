graph handle-conv-rename-keydown {
  meta: { description: "Handle keydown during rename - Enter to confirm save", type: "action", category: "context-menu", author: "AITOS Team" }

  let getKeydown = get(key: "_renameKeyEvent")
  let getKey = getProp(obj: "{{getKeydown}}", key: "key")
  let isEnter = eq(a: "{{getKey}}", b: "Enter")
  let handleEnter = if isEnter {
    let doSave = execFile(file: "ui/components/context-menu/handle-conv-rename-save")
  }
}