graph handle-conv-delete {
  meta: { description: "Handle conversation delete from right-click context menu", type: "core", input: "_convDelId", output: "conversations, currentConversationId, _activeContext" }

  let hideMenu = execFile(file: "ui/components/context-menu/hide")
  let execDelete = execFile(file: "conversations/delete-conversation")
  let clearConvDelId = setGlobal(key: "_convDelId", value: null)
}