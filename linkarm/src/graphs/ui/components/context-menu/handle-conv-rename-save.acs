graph handle-conv-rename-save {
  meta: { description: "Save inline-edited conversation title and restore span", type: "core", input: "_renameInputId, _convDelId, _convRenameTitle, conversations", output: "conversations" }

  let getInputId = get(key: "_renameInputId")
  let getNewTitle = getValue(id: "{{getInputId}}")
  let inputFailed = isError(value: "{{getNewTitle}}")
  let inputExists = not(value: "{{inputFailed}}")
  let branchExists = if inputExists {
    let nameLen = len(value: "{{getNewTitle}}")
    let isNotEmpty = gt(a: "{{nameLen}}", b: 0)
    let getConvId = get(key: "_convDelId")
    let getCurrentTitle = get(key: "_convRenameTitle")
    let isSame = eq(a: "{{getNewTitle}}", b: "{{getCurrentTitle}}")
    let branchChanged = if isNotEmpty {
      let branchNotSame = if isSame {
        let restoreTitle = execFile(file: "ui/components/context-menu/handle-conv-rename-restore")
      } else {
        let getConversations = get(key: "conversations")
        let getRenamedConvs = map conv in getConversations {
          let getCurConvId = getProp(obj: "{{conv}}", key: "id")
          let isTarget = eq(a: "{{getCurConvId}}", b: "{{getConvId}}")
          let handleTarget = if isTarget {
            let updatedConv = setProp(obj: "{{conv}}", key: "title", value: "{{getNewTitle}}")
          } else {
            let keepConv = merge(a: "{{conv}}", b: {})
          }
        }
        let updateStore = setGlobal(key: "conversations", value: "{{getRenamedConvs}}")
        let saveConversations = execFile(file: "conversations/save-conversations")
        let updateSidebar = executeInContext(contextKey: "_activeContext", graphKey: "__graph_ui/layout/sidebar/create")
      }
    }
    let handleEmpty = if isNotEmpty {
    } else {
      let restoreTitle = execFile(file: "ui/components/context-menu/handle-conv-rename-restore")
    }
  }
}