graph show {
  meta: { description: "Context menu dispatcher - creates shell, routes to sub-graph", type: "core", input: "_contextMenuEvent_x, _contextMenuEvent_y, _contextMenuEvent_targetId", output: "_contextMenuGrowthIndex, _contextMenuModelId, context menu DOM" }

  let mouseX = get(key: "_contextMenuEvent_x")
  let mouseY = get(key: "_contextMenuEvent_y")
  let eventTarget = get(key: "_contextMenuEvent_targetId")

  let createMenu = createElement(tag: "div", id: "contextMenu")
  let setMenuStyles = setStyles(id: "contextMenu", styles: { position: "fixed", left: "{{mouseX}}px", top: "{{mouseY}}px", background: "#fff", border: "1px solid #e0e0e0", borderRadius: "8px", boxShadow: "0 4px 12px rgba(0,0,0,0.12)", padding: "0", zIndex: "2000", minWidth: "160px" })
  let appendMenu = appendChild(parentId: "appContainer", childId: "contextMenu")

  let setMenuItemStyles = injectCSS(id: "contextMenuItemHover", css: ".context-menu-item:hover { background: #e8e8e8; } .context-menu-item { margin: 0; }")

  let findGrowth = closest(id: "{{eventTarget}}", selector: ".growth-card")
  let findGrowthNil = isNil(value: "{{findGrowth}}")
  let isGrowthCard = not(value: "{{findGrowthNil}}")
  let growthRoute = if isGrowthCard {
    let getCardIndex = slice(array: "{{findGrowth}}", start: 12)
    let saveGrowthIndex = set(key: "_contextMenuGrowthIndex", value: "{{getCardIndex}}")
    let showGrowthMenu = execFile(file: "ui/components/context-menu/show-growth-card")
  }
  let findModel = closest(id: "{{eventTarget}}", selector: ".model-card")
  let findModelNil = isNil(value: "{{findModel}}")
  let isModelCard = not(value: "{{findModelNil}}")
  let modelRoute = if isModelCard {
    let getModelId = slice(array: "{{findModel}}", start: 11)
    let saveModelId = set(key: "_contextMenuModelId", value: "{{getModelId}}")
    let showModelMenu = execFile(file: "ui/components/context-menu/show-model-card")
  }
  let blankRoute = if isGrowthCard {
    let skip = set(key: "_routeSkipped", value: true)
  } else {
    let checkModel = if isModelCard {
      let skip = set(key: "_routeSkipped", value: true)
    } else {
      let showBlankMenu = execFile(file: "ui/components/context-menu/show-blank")
    }
  }

  let createOverlay = createElement(tag: "div", id: "contextMenuOverlay")
  let setOverlayStyles = setStyles(id: "contextMenuOverlay", styles: { position: "fixed", top: "0", left: "0", right: "0", bottom: "0", zIndex: "1999" })
  let appendOverlay = appendChild(parentId: "appContainer", childId: "contextMenuOverlay")
}
