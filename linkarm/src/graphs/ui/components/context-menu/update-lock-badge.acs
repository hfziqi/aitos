graph update-lock-badge {
  meta: { description: "Show or hide lock badge on a growth card — pure UI, no data writes", type: "core", input: "_contextMenuGrowthIndex, locked", output: "lock badge DOM" }

  let getCardIndex = get(key: "_contextMenuGrowthIndex")
  let isLocking = get(key: "locked")
  let cardId = concat(a: "growth_card_", b: "{{getCardIndex}}")
  let badgeId = concat(a: "{{cardId}}", b: "_lock")
  let updateBadge = if isLocking {
    let showBadge = setStyles(id: "{{badgeId}}", styles: { display: "block" })
  } else {
    let hideBadge = setStyles(id: "{{badgeId}}", styles: { display: "none" })
  }
}
