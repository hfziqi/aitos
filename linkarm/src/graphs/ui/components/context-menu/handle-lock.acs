graph handle-lock {
  meta: { description: "Handle lock/unlock from context menu — action dispatch only", type: "core", input: "clickTargetId, _contextMenuGrowthName", output: "locked, lockGrowthResult" }

  let getTargetId = get(key: "clickTargetId")
  let isLockBtn = eq(a: "{{getTargetId}}", b: "contextMenuLockBtn")
  let getGrowthName = get(key: "_contextMenuGrowthName")
  let shouldLock = if isLockBtn {
    let setLocked = set(key: "locked", value: true)
  } else {
    let setUnlocked = set(key: "locked", value: false)
  }
  let setLockName = set(key: "name", value: "{{getGrowthName}}")
  let execLock = execFile(file: "growth/lock-growth")
  let updateBadge = execFile(file: "ui/components/context-menu/update-lock-badge")
  let hideMenu = execFile(file: "ui/components/context-menu/hide")
}
