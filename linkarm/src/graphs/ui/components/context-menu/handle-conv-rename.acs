graph handle-conv-rename {
  meta: { description: "Inline edit conversation title - replace span with input", type: "core", input: "_convDelId, _convRenameTitle, _convRenameItemId", output: "_renameInputId, rename input DOM" }

  let hideMenu = execFile(file: "ui/components/context-menu/hide")
  let getConvId = get(key: "_convDelId")
  let getCurrentTitle = get(key: "_convRenameTitle")
  let getRenameItemId = get(key: "_convRenameItemId")
  let convIndex = slice(array: "{{getRenameItemId}}", start: 9)
  let titleId = concat(a: "convTitle-", b: "{{convIndex}}")
  let inputId = concat(a: "convRenameInput-", b: "{{convIndex}}")
  let storeInputId = setGlobal(key: "_renameInputId", value: "{{inputId}}")
  let removeTitleSpan = removeElement(id: "{{titleId}}")
  let createInput = createElement(tag: "input", id: "{{inputId}}")
  let setInputValue = setValue(id: "{{inputId}}", value: "{{getCurrentTitle}}")
  let setInputStyles = setStyles(id: "{{inputId}}", styles: { flex: "1", minWidth: "0", border: "1px solid #4a90d9", borderRadius: "4px", padding: "2px 4px", fontSize: "14px", outline: "none", background: "#fff" })
  let setInputClass = setAttribute(id: "{{inputId}}", name: "class", value: "sidebar-item-input")
  let appendInput = appendChild(parentId: "{{getRenameItemId}}", childId: "{{inputId}}")
  let focusInput = focus(id: "{{inputId}}")
  let registerBlur = addEventListener(id: "{{inputId}}", event: "blur", storeKey: "_renameBlurEvent", action: "ui/components/context-menu/handle-conv-rename-save")
  let registerKeydown = addEventListener(id: "{{inputId}}", event: "keydown", storeKey: "_renameKeyEvent", action: "ui/components/context-menu/handle-conv-rename-keydown", preventDefault: true)
}