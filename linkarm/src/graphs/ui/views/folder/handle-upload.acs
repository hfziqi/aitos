graph handle-upload {
  meta: { description: "Upload a file from local system to the folder view", type: "core", input: "_folderPath", output: "_uploadFileKey, _uploadSkip" }

  let hideMenu = execFile(file: "ui/components/context-menu/hide")
  let pickFile = showFilePicker(accept: ".txt,.md,.csv,.json,.xml,.html,.css,.js,.ts")
  let checkFile = isNil(value: "{{pickFile}}")
  let handleFile = if checkFile {
    let skip = set(key: "_uploadSkip", value: true)
  } else {
    let fileName = getProp(obj: "{{pickFile}}", key: "name")
    let readContent = readFile(file: "{{pickFile}}", encoding: "text")
    let getFolderPath = get(key: "_folderPath")
    let pathNil = isNil(value: "{{getFolderPath}}")
    let buildPath = if pathNil {
      let rootPath = concat(a: "folders/", b: "{{fileName}}")
      let setFileKey = set(key: "_uploadFileKey", value: "{{rootPath}}")
    } else {
      let subPath = concat(a: "folders/", b: "{{getFolderPath}}")
      let fullPath = concat(a: "{{subPath}}", b: "/")
      let filePath = concat(a: "{{fullPath}}", b: "{{fileName}}")
      let setFileKey = set(key: "_uploadFileKey", value: "{{filePath}}")
    }
    let getFileKey = get(key: "_uploadFileKey")
    let saveFile = writeLocal(key: "{{getFileKey}}", value: "{{readContent}}")
    let refreshView = execFile(file: "ui/views/folder/create")
  }
}