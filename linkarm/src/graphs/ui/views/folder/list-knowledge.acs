graph list-knowledge {
  meta: { description: "List files and folders in the knowledge base", type: "tool", input: "path", output: "_knowledgeItems" }
  out: result

  let getPath = get(key: "path")
  let pathNil = isNil(value: "{{getPath}}")
  let buildScope = if pathNil {
    let rootScope = set(key: "_listScope", value: "folders/")
  } else {
    let subScope = concat(a: "folders/", b: "{{getPath}}")
    let subScopeFull = concat(a: "{{subScope}}", b: "/")
    let setScope = set(key: "_listScope", value: "{{subScopeFull}}")
  }
  let getScope = get(key: "_listScope")
  let listFiles = listLocal(scope: "{{getScope}}")
  let initItems = set(key: "_knowledgeItems", value: [])
  let checkIsArr = isArr(value: "{{listFiles}}")
  let handleList = if checkIsArr {
    let forEach = forEach file, fileIndex in listFiles {
      let stripPrefix = replace(text: "{{file}}", search: "{{getScope}}", replacement: "")
      let hasSlash = contains(text: "{{stripPrefix}}", search: "/")
      let isDirectChild = not(value: "{{hasSlash}}")
      let handleDirect = if isDirectChild {
        let hasDot = contains(text: "{{stripPrefix}}", search: ".")
        let isFolder = not(value: "{{hasDot}}")
        let getItems = get(key: "_knowledgeItems")
        let itemType = if isFolder {
          let folderItem = set(key: "_itemType", value: "folder")
        } else {
          let fileItem = set(key: "_itemType", value: "file")
        }
        let getType = get(key: "_itemType")
        let newItem = push(array: "{{getItems}}", value: { name: "{{stripPrefix}}", type: "{{getType}}" })
        let saveItems = set(key: "_knowledgeItems", value: "{{newItem}}")
      }
    }
  }
  let result = get(key: "_knowledgeItems")
}