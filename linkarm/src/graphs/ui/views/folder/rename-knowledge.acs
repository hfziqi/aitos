graph rename-knowledge {
  meta: { description: "Rename a file or folder in the knowledge base", type: "tool", input: "oldName, newName", output: "result" }
  out: result

  let getOldName = get(key: "oldName")
  let getNewName = get(key: "newName")
  let nameNil = isNil(value: "{{getOldName}}")
  let handleName = if nameNil {
    let setError = set(key: "result", value: { success: false, error: "Missing oldName" })
  } else {
    let newNameNil = isNil(value: "{{getNewName}}")
    let handleNew = if newNameNil {
      let setError = set(key: "result", value: { success: false, error: "Missing newName" })
    } else {
      let getFolderPath = get(key: "_folderPath")
      let renameItem = execFile(file: "ui/views/folder/_rename-item", store: { _oldItemName: "{{getOldName}}", _newItemName: "{{getNewName}}", _folderPath: "{{getFolderPath}}" }, isolated: true)
      let getResult = get(key: "_operationResult")
      let setResult = set(key: "result", value: "{{getResult}}")
    }
  }
  let result = get(key: "result")
}