graph context-menu {
  meta: { description: "Folder view context menu - item-specific and blank area", type: "core", input: "_folderContextMenuEvent_x, _folderContextMenuEvent_y, _folderContextMenuEvent_targetId, _folderItems", output: "_ctxItemIndex, _ctxMarker, context menu DOM" }

  let mouseX = get(key: "_folderContextMenuEvent_x")
  let mouseY = get(key: "_folderContextMenuEvent_y")
  let eventTarget = get(key: "_folderContextMenuEvent_targetId")

  let createMenu = createElement(tag: "div", id: "contextMenu")
  let setMenuStyles = setStyles(id: "contextMenu", styles: { position: "fixed", left: "{{mouseX}}px", top: "{{mouseY}}px", background: "#fff", border: "1px solid #e0e0e0", borderRadius: "8px", boxShadow: "0 4px 12px rgba(0,0,0,0.12)", padding: "0", zIndex: "2000", minWidth: "160px" })
  let appendMenu = appendChild(parentId: "appContainer", childId: "contextMenu")

  let setMenuItemStyles = injectCSS(id: "folderCtxMenuStyles", css: ".context-menu-item:hover { background: #e8e8e8; } .context-menu-item { margin: 0; }")

  let findItem = closest(id: "{{eventTarget}}", selector: "[id^='folderItem-']")
  let findItemNil = isNil(value: "{{findItem}}")
  let isItem = not(value: "{{findItemNil}}")
  let routeMenu = if isItem {
    let getItemIndex = slice(array: "{{findItem}}", start: 11)
    let saveIndex = set(key: "_ctxItemIndex", value: "{{getItemIndex}}")
    let createOpen = createElement(tag: "div", id: "folderCtxOpen")
    let setOpenStyles = setStyles(id: "folderCtxOpen", styles: { padding: "8px 16px", fontSize: "14px", cursor: "default", color: "#333", display: "flex", alignItems: "center", gap: "8px" })
    let setOpenClass = setAttribute(id: "folderCtxOpen", name: "class", value: "context-menu-item")
    let setOpenText = setTextContent(id: "folderCtxOpen", text: "Open")
    let appendOpen = appendChild(parentId: "contextMenu", childId: "folderCtxOpen")
    let createRename = createElement(tag: "div", id: "folderCtxRename")
    let setRenameStyles = setStyles(id: "folderCtxRename", styles: { padding: "8px 16px", fontSize: "14px", cursor: "default", color: "#333", display: "flex", alignItems: "center", gap: "8px" })
    let setRenameClass = setAttribute(id: "folderCtxRename", name: "class", value: "context-menu-item")
    let setRenameText = setTextContent(id: "folderCtxRename", text: "Rename")
    let appendRename = appendChild(parentId: "contextMenu", childId: "folderCtxRename")
    let createDelete = createElement(tag: "div", id: "folderCtxDelete")
    let setDeleteStyles = setStyles(id: "folderCtxDelete", styles: { padding: "8px 16px", fontSize: "14px", cursor: "default", color: "#d32f2f", display: "flex", alignItems: "center", gap: "8px" })
    let setDeleteClass = setAttribute(id: "folderCtxDelete", name: "class", value: "context-menu-item")
    let setDeleteText = setTextContent(id: "folderCtxDelete", text: "Delete")
    let appendDelete = appendChild(parentId: "contextMenu", childId: "folderCtxDelete")
  } else {
    let createNewFolder = createElement(tag: "div", id: "folderCtxNewFolder")
    let setNewFolderStyles = setStyles(id: "folderCtxNewFolder", styles: { padding: "8px 16px", fontSize: "14px", cursor: "default", color: "#333", display: "flex", alignItems: "center", gap: "8px" })
    let setNewFolderClass = setAttribute(id: "folderCtxNewFolder", name: "class", value: "context-menu-item")
    let setNewFolderText = setTextContent(id: "folderCtxNewFolder", text: "New Folder")
    let appendNewFolder = appendChild(parentId: "contextMenu", childId: "folderCtxNewFolder")
    let createNewFile = createElement(tag: "div", id: "folderCtxNewFile")
    let setNewFileStyles = setStyles(id: "folderCtxNewFile", styles: { padding: "8px 16px", fontSize: "14px", cursor: "default", color: "#333", display: "flex", alignItems: "center", gap: "8px" })
    let setNewFileClass = setAttribute(id: "folderCtxNewFile", name: "class", value: "context-menu-item")
    let setNewFileText = setTextContent(id: "folderCtxNewFile", text: "New Text File")
    let appendNewFile = appendChild(parentId: "contextMenu", childId: "folderCtxNewFile")
    let createUpload = createElement(tag: "div", id: "folderCtxUpload")
    let setUploadStyles = setStyles(id: "folderCtxUpload", styles: { padding: "8px 16px", fontSize: "14px", cursor: "default", color: "#333", display: "flex", alignItems: "center", gap: "8px" })
    let setUploadClass = setAttribute(id: "folderCtxUpload", name: "class", value: "context-menu-item")
    let setUploadText = setTextContent(id: "folderCtxUpload", text: "Upload File")
    let appendUpload = appendChild(parentId: "contextMenu", childId: "folderCtxUpload")
  }

  let createOverlay = createElement(tag: "div", id: "contextMenuOverlay")
  let setOverlayStyles = setStyles(id: "contextMenuOverlay", styles: { position: "fixed", top: "0", left: "0", right: "0", bottom: "0", zIndex: "1999" })
  let appendOverlay = appendChild(parentId: "appContainer", childId: "contextMenuOverlay")
}