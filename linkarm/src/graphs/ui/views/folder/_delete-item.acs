graph _delete-item {
  meta: { description: "Shared: Delete a file or folder from the knowledge base", type: "core", input: "_itemName, _folderPath", output: "_operationResult" }

  let getName = get(key: "_itemName")
  let getFolderPath = get(key: "_folderPath")
  let nameNil = isNil(value: "{{getName}}")
  let handleName = if nameNil {
    let setError = set(key: "_operationResult", value: { success: false, error: "Missing name" })
  } else {
    let pathNil = isNil(value: "{{getFolderPath}}")
    let buildKey = if pathNil {
      let rootKey = set(key: "_delKey", value: "folders/{{getName}}")
    } else {
      let subKey = concat(a: "folders/", b: "{{getFolderPath}}")
      let fullKey = concat(a: "{{subKey}}", b: "/{{getName}}")
      let setKey = set(key: "_delKey", value: "{{fullKey}}")
    }
    let getDelKey = get(key: "_delKey")
    let removeItem = removeLocal(key: "{{getDelKey}}")
    let setResult = set(key: "_operationResult", value: { success: true, name: "{{getName}}" })
  }
}