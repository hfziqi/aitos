graph create {
  meta: { description: "Folder view with grid layout", type: "core", input: "_folderPath", output: "_folderItems, _listScope, folder DOM" }

  let clearOldContainer = clearElement(id: "folderContainer")
  let getFolderPath = get(key: "_folderPath")
  let pathNil = isNil(value: "{{getFolderPath}}")
  let buildScope = if pathNil {
    let rootScope = set(key: "_listScope", value: "folders/")
  } else {
    let subScope = concat(a: "folders/", b: "{{getFolderPath}}")
    let subScopeFull = concat(a: "{{subScope}}", b: "/")
    let setScope = set(key: "_listScope", value: "{{subScopeFull}}")
  }
  let getScope = get(key: "_listScope")
  let listFiles = listLocal(scope: "{{getScope}}")
  let initItems = set(key: "_folderItems", value: [])
  let checkIsArr = isArr(value: "{{listFiles}}")
  let handleList = if checkIsArr {
    let forEach = forEach file, fileIndex in listFiles {
      let stripPrefix = replace(text: "{{file}}", search: "{{getScope}}", replacement: "")
      let hasSlash = contains(text: "{{stripPrefix}}", search: "/")
      let isDirectChild = not(value: "{{hasSlash}}")
      let handleDirect = if isDirectChild {
        let hasDot = contains(text: "{{stripPrefix}}", search: ".")
        let isFolder = not(value: "{{hasDot}}")
        let handleFolder = if isFolder {
          let getItems = get(key: "_folderItems")
          let newItem = push(array: "{{getItems}}", value: { name: "{{stripPrefix}}", type: "folder" })
          let saveItems = set(key: "_folderItems", value: "{{newItem}}")
        } else {
          let getItems = get(key: "_folderItems")
          let newItem = push(array: "{{getItems}}", value: { name: "{{stripPrefix}}", type: "file" })
          let saveItems = set(key: "_folderItems", value: "{{newItem}}")
        }
      }
    }
  }
  let createContainer = createElement(tag: "div", id: "folderContainer")
  let setLayoutStyles = setStyles(id: "folderContainer", styles: { width: "100%", height: "100%", overflow: "auto", padding: "0px 16px 16px 16px", backgroundColor: "#f1f1f1" })
  let execStyles = execFile(file: "ui/views/folder/styles")
  let appendContainer = appendChild(parentId: "mainViewContainer", childId: "folderContainer")
  let createBackBtn = createElement(tag: "div", id: "folderBackBtn")
  let setBackBtnText = setTextContent(id: "folderBackBtn", text: "‹")
  let pathNil = isNil(value: "{{getFolderPath}}")
  let setBackVisibility = if pathNil {
    let hide = setStyles(id: "folderBackBtn", styles: { display: "none" })
  } else {
    let show = setStyles(id: "folderBackBtn", styles: { position: "fixed", top: "0", right: "138px", width: "46px", height: "32px", display: "flex", alignItems: "center", justifyContent: "center", fontSize: "22px", fontWeight: "500", color: "rgba(100,100,100,1)", cursor: "default", transition: "background 0.15s ease", zIndex: "100" })
  }
  let appendBackBtn = appendChild(parentId: "folderContainer", childId: "folderBackBtn")
  let createGrid = createElement(tag: "div", id: "folderGrid")
  let setGridStyles = setStyles(id: "folderGrid", styles: { display: "grid", gridTemplateColumns: "repeat(auto-fill, minmax(88px, 1fr))", gap: "12px" })
  let appendGrid = appendChild(parentId: "folderContainer", childId: "folderGrid")
  let renderItems = if _folderItems {
    let forEach = forEach item, itemIndex in _folderItems {
      let createItem = createElement(tag: "div", id: "folderItem-{{itemIndex}}")
      let setItemClass = setAttribute(id: "folderItem-{{itemIndex}}", name: "class", value: "folder-item")
      let appendItem = appendChild(parentId: "folderGrid", childId: "folderItem-{{itemIndex}}")
      let getItemType = getProp(obj: "{{item}}", key: "type")
      let isFolderType = eq(a: "{{getItemType}}", b: "folder")
      let renderIcon = if isFolderType {
        let createIcon = createElement(tag: "div", id: "folderIcon-{{itemIndex}}")
        let setIconClass = setAttribute(id: "folderIcon-{{itemIndex}}", name: "class", value: "folder-item-icon")
        let setIconSvg = setInnerHTML(id: "folderIcon-{{itemIndex}}", html: "<svg width=\"65\" height=\"65\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\" style=\"filter:drop-shadow(0px 1px 1px rgba(0,0,0,0.15))\"><path d=\"M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z\" fill=\"#FFC107\"/></svg>")
        let appendIcon = appendChild(parentId: "folderItem-{{itemIndex}}", childId: "folderIcon-{{itemIndex}}")
      } else {
        let createIcon = createElement(tag: "div", id: "fileIcon-{{itemIndex}}")
        let setIconClass = setAttribute(id: "fileIcon-{{itemIndex}}", name: "class", value: "folder-item-icon")
        let setIconSvg = setInnerHTML(id: "fileIcon-{{itemIndex}}", html: "<svg width=\"65\" height=\"65\" viewBox=\"0 0 32 40\" xmlns=\"http://www.w3.org/2000/svg\" style=\"filter:drop-shadow(0px 1px 1px rgba(0,0,0,0.15))\"><path d=\"M4 1H20L28 9V39H4V1Z\" fill=\"white\"/><path d=\"M20 1V9H28\" fill=\"#E8E8E8\"/><rect x=\"8\" y=\"14\" width=\"14\" height=\"1.5\" rx=\"0.75\" fill=\"#C5C5C5\"/><rect x=\"8\" y=\"18\" width=\"14\" height=\"1.5\" rx=\"0.75\" fill=\"#C5C5C5\"/><rect x=\"8\" y=\"22\" width=\"14\" height=\"1.5\" rx=\"0.75\" fill=\"#C5C5C5\"/></svg>")
        let appendIcon = appendChild(parentId: "folderItem-{{itemIndex}}", childId: "fileIcon-{{itemIndex}}")
      }
      let getItemName = getProp(obj: "{{item}}", key: "name")
      let displayName = replace(text: "{{getItemName}}", search: ".txt", replacement: "")
      let createName = createElement(tag: "div", id: "folderName-{{itemIndex}}")
      let setNameClass = setAttribute(id: "folderName-{{itemIndex}}", name: "class", value: "folder-item-name")
      let setNameText = setTextContent(id: "folderName-{{itemIndex}}", text: "{{displayName}}")
      let appendName = appendChild(parentId: "folderItem-{{itemIndex}}", childId: "folderName-{{itemIndex}}")
    }
  }
  let listenRightClick = addEventListener(id: "folderContainer", event: "contextmenu", storeKey: "_folderContextMenuEvent", action: "ui/views/folder/context-menu", preventDefault: true)
  let listenDblClick = addEventListener(id: "folderGrid", event: "dblclick", storeKey: "_folderDblClick", action: "ui/views/folder/handle-dblclick", preventDefault: true)
}