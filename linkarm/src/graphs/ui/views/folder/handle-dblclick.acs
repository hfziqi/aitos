graph handle-dblclick {
  meta: { description: "Handle double-click on folder items - navigate into folders, open files", type: "core", input: "_folderDblClick_targetId, _folderItems, _folderPath", output: "_folderPath, _folderName, _pathFileName" }

  let eventTarget = get(key: "_folderDblClick_targetId")
  let findItem = closest(id: "{{eventTarget}}", selector: "[id^='folderItem-']")
  let isNilItem = isNil(value: "{{findItem}}")
  let handleItem = if isNilItem {
    let skip = set(key: "_dblSkip", value: true)
  } else {
    let getItemIndex = slice(array: "{{findItem}}", start: 11)
    let getIndex = toNum(value: "{{getItemIndex}}")
    let getItems = get(key: "_folderItems")
    let getItem = getAt(array: "{{getItems}}", index: "{{getIndex}}")
    let getItemType = getProp(obj: "{{getItem}}", key: "type")
    let isFolder = eq(a: "{{getItemType}}", b: "folder")
    let handleType = if isFolder {
      let getItemName = getProp(obj: "{{getItem}}", key: "name")
      let getCurrentPath = get(key: "_folderPath")
      let pathNil = isNil(value: "{{getCurrentPath}}")
      let buildPath = if pathNil {
        let setPath = set(key: "_folderPath", value: "{{getItemName}}")
      } else {
        let appendSlash = concat(a: "{{getCurrentPath}}", b: "/")
        let fullPath = concat(a: "{{appendSlash}}", b: "{{getItemName}}")
        let setPath = set(key: "_folderPath", value: "{{fullPath}}")
      }
      let setFolderName = set(key: "_folderName", value: "{{getItemName}}")
      let refreshView = execFile(file: "ui/views/folder/create")
    } else {
      let getItemName = getProp(obj: "{{getItem}}", key: "name")
      let getFolderPath = get(key: "_folderPath")
      let buildFilePath = execFile(file: "ui/views/folder/_build-path", store: { _pathFileName: "{{getItemName}}", _folderPath: "{{getFolderPath}}" }, isolated: true)
      let getFileKey = get(key: "_resolvedPath")
      let launchOpen = openFile(key: "{{getFileKey}}", app: "notepad.exe")
    }
  }
}