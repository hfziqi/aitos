graph read-knowledge {
  meta: { description: "Read a file from the knowledge base", type: "tool", input: "name", output: "result" }
  out: result

  let getName = get(key: "name")
  let nameNil = isNil(value: "{{getName}}")
  let handleName = if nameNil {
    let setError = set(key: "result", value: { success: false, error: "Missing file name" })
  } else {
    let filePath = concat(a: "folders/", b: "{{getName}}")
    let readContent = readLocal(key: "{{filePath}}")
    let contentNil = isNil(value: "{{readContent}}")
    let handleRead = if contentNil {
      let setError = set(key: "result", value: { success: false, error: "File not found: {{getName}}" })
    } else {
      let setResult = set(key: "result", value: { success: true, name: "{{getName}}", content: "{{readContent}}" })
    }
  }
  let result = get(key: "result")
}