graph _create-file {
  meta: { description: "Shared: Create a text file in the knowledge base", type: "core", input: "_itemName, _itemContent, _folderPath", output: "_operationResult" }

  let getName = get(key: "_itemName")
  let getContent = get(key: "_itemContent")
  let getFolderPath = get(key: "_folderPath")
  let nameNil = isNil(value: "{{getName}}")
  let handleName = if nameNil {
    let setError = set(key: "_operationResult", value: { success: false, error: "Missing file name" })
  } else {
    let stripMd = replace(text: "{{getName}}", search: ".md", replacement: "")
    let stripTxt = replace(text: "{{stripMd}}", search: ".txt", replacement: "")
    let fileName = concat(a: "{{stripTxt}}", b: ".txt")
    let pathNil = isNil(value: "{{getFolderPath}}")
    let buildPath = if pathNil {
      let rootPath = set(key: "_filePath", value: "folders/{{fileName}}")
    } else {
      let subPath = concat(a: "folders/", b: "{{getFolderPath}}")
      let fullPath = concat(a: "{{subPath}}", b: "/{{fileName}}")
      let setPath = set(key: "_filePath", value: "{{fullPath}}")
    }
    let getFilePath = get(key: "_filePath")
    let contentNil = isNil(value: "{{getContent}}")
    let fileContent = if contentNil {
      let emptyContent = set(key: "_fileContent", value: "")
    } else {
      let useContent = set(key: "_fileContent", value: "{{getContent}}")
    }
    let getContent2 = get(key: "_fileContent")
    let writeFile = writeLocal(key: "{{getFilePath}}", value: "{{getContent2}}")
    let setResult = set(key: "_operationResult", value: { success: true, name: "{{fileName}}" })
  }
}