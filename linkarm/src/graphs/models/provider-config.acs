graph provider-config {
  meta: { description: "Provider configuration data", type: "core", output: "_providersList, _providersMap, _providerModels, providerConfig" }

  let setProviders = set(key: "_providersList", value: [{ id: "deepseek", name: "DeepSeek", baseUrl: "https://api.deepseek.com", logo: "/deepseek.png" }])
  let setProvidersMap = set(key: "_providersMap", value: { deepseek: { name: "DeepSeek", baseUrl: "https://api.deepseek.com", logo: "/deepseek.png" } })
  let setModels = set(key: "_providerModels", value: { deepseek: ["deepseek-v4-flash", "deepseek-v4-pro"] })
  let getProviderList = get(key: "_providersList")
  let getProviderMap = get(key: "_providersMap")
  let getModelList = get(key: "_providerModels")
  let setConfig = set(key: "providerConfig", value: { providers: "{{getProviderList}}", providersMap: "{{getProviderMap}}", models: "{{getModelList}}" })
}