graph open-market {
  meta: { description: "Open AI model market", type: "core", output: "currentView, market view DOM" }

  let setView = setGlobal(key: "currentView", value: "market")
  let clearMainView = clearElement(id: "mainViewContainer")
  let execMarketView = execFile(file: "ui/views/market/create")
  let updateToolbar = execFile(file: "ui/layout/toolbar/update-active")
}