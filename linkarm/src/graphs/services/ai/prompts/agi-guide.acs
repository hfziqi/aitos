graph agi-guide {
  meta: { description: "AGI multi-model orchestration guide", type: "core", input: "aiModelsList, activeModelId", output: "AGI prompt text" }

  let getModels = get(key: "aiModelsList")
  let getActiveId = get(key: "activeModelId")
  let otherModels = filter item in getModels {
    let itemId = getProp(obj: "{{item}}", key: "id")
    let isActive = eq(a: "{{itemId}}", b: "{{getActiveId}}")
    let isOther = not(value: "{{isActive}}")
  }
  let setPrompt = set(key: "_promptAgiGuide", value: "## AGI Multi-Model Collaboration\n\nYou can call other AI models to help complete tasks. Consider using a sub-model when:\n\n1. Specialized knowledge is needed (code review, translation, writing, etc.)\n2. The task can be split into parallel parts\n3. The user explicitly asks to use a different model\n\nAvailable tool:\n  call-model(modelId, task)\n    - modelId: target model ID\n    - task: description of the task to delegate\n\nUsage strategy:\n- Answer simple questions yourself - no sub-model needed\n- Parallel tasks can call multiple sub-models at once\n- After sub-models return, aggregate and optimize the final output")
}
