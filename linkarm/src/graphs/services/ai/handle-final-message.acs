graph handle-final-message {
  meta: { description: "Handle final assistant text response - append to context and end loop", type: "core", input: "apiResponse_content, _apiContext", output: "finalContent, _apiContext, continueLoop" }

  let getContent = get(key: "apiResponse_content")
  let buildFinalMsg = merge(a: { role: "assistant" }, b: { content: "{{getContent}}" })
  let getMsgs = get(key: "_apiContext")
  let pushAssistantFinal = push(array: "{{getMsgs}}", value: "{{buildFinalMsg}}")
  let saveMessagesFinal = set(key: "_apiContext", value: "{{pushAssistantFinal}}")
  let saveFinalContent = set(key: "finalContent", value: "{{getContent}}")
  let setContinueFalse = set(key: "continueLoop", value: false)
}
