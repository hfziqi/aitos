graph call-model {
  meta: { description: "Call another AI model to execute a sub-task. Supports tool calls within sub-model.", type: "tool", input: "modelId, task, aiModelsList", output: "callModelResult" }
  out: callModelResult

  let getModelId = get(key: "modelId")
  let getTask = get(key: "task")
  let getModels = get(key: "aiModelsList")
  let filterModel = filter item in getModels {
    let itemId = getProp(obj: "{{item}}", key: "id")
    let isMatch = eq(a: "{{itemId}}", b: "{{getModelId}}")
  }
  let targetModel = getAt(array: "{{filterModel}}", index: 0)
  let modelNil = isNil(value: "{{targetModel}}")
  let handleMissing = if modelNil {
    let setError = set(key: "callModelResult", value: { success: false, error: "Model '{{getModelId}}' not found" })
  } else {
    let getBaseUrl = getProp(obj: "{{targetModel}}", key: "baseUrl")
    let getApiKey = getProp(obj: "{{targetModel}}", key: "apiKey")
    let getModelName = getProp(obj: "{{targetModel}}", key: "modelName")
    let getName = getProp(obj: "{{targetModel}}", key: "name")
    let apiUrl = concat(a: "{{getBaseUrl}}", b: "/chat/completions")
    let getToolbox = get(key: "_toolsConfig")
    let setSubTools = set(key: "_subTools", value: "{{getToolbox}}")
    let initMsgs = set(key: "_subMessages", value: [{ role: "user", content: "{{getTask}}" }])
    let initLoop = set(key: "continueSubLoop", value: true)
    let initIter = set(key: "_subIteration", value: 0)
    let subLoop = loop cond: "continueSubLoop" {
      let getIter = get(key: "_subIteration")
      let incIter = add(a: "{{getIter}}", b: 1)
      let saveIter = set(key: "_subIteration", value: "{{incIter}}")
      let getMsgList = get(key: "_subMessages")
      let getToolsList = get(key: "_subTools")
      let callApi = httpStreamRequest(url: "{{apiUrl}}", headers: { Authorization: "Bearer {{getApiKey}}", "Content-Type": "application/json" }, body: { model: "{{getModelName}}", messages: "{{getMsgList}}", tools: "{{getToolsList}}", stream: true })
      let saveResponse = set(key: "_subApiResponse", value: "{{callApi}}")
      let getResp = get(key: "_subApiResponse")
      let getToolCalls = getProp(obj: "{{getResp}}", key: "toolCalls")
      let getToolLen = len(value: "{{getToolCalls}}")
      let hasTools = gt(a: "{{getToolLen}}", b: 0)
      let getContent = getProp(obj: "{{getResp}}", key: "content")
      let handleBranch = if hasTools {
        let buildAssistant = merge(a: { role: "assistant", content: "{{getContent}}" }, b: { tool_calls: "{{getToolCalls}}" })
        let pushAssistant = push(array: "{{getMsgList}}", value: "{{buildAssistant}}")
        let saveAssistant = set(key: "_subMsgsAcc", value: "{{pushAssistant}}")
        let getToolbox = get(key: "_toolsConfig")
        let getFilteredCalls = filter call in getToolCalls {
          let getCallFunc = getProp(obj: "{{call}}", key: "function")
          let getCallName = getProp(obj: "{{getCallFunc}}", key: "name")
          let findMatch = filter item in getToolbox {
            let itemName = getProp(obj: "{{item.function}}", key: "name")
            let isSame = eq(a: "{{itemName}}", b: "{{getCallName}}")
          }
          let matchLen = len(value: "{{findMatch}}")
          let isAllowed = gt(a: "{{matchLen}}", b: 0)
        }
        let execTools = handleToolCalls(toolCalls: "{{getFilteredCalls}}")
        let appendResults = forEach toolResult in execTools {
          let getAcc = get(key: "_subMsgsAcc")
          let pushTool = push(array: "{{getAcc}}", value: { role: "tool", tool_call_id: "{{toolResult.toolCallId}}", content: "{{toolResult.result}}" })
          let saveAcc = set(key: "_subMsgsAcc", value: "{{pushTool}}")
        }
        let saveMsgs = set(key: "_subMessages", value: "{{_subMsgsAcc}}")
        let checkLimit = gt(a: "{{incIter}}", b: 5)
        let stopIfLimit = if checkLimit {
          let setStop = set(key: "continueSubLoop", value: false)
          let setResult = set(key: "callModelResult", value: { success: true, modelId: "{{getModelId}}", modelName: "{{getName}}", content: "{{getContent}}" })
        }
      } else {
        let setStop = set(key: "continueSubLoop", value: false)
        let setResult = set(key: "callModelResult", value: { success: true, modelId: "{{getModelId}}", modelName: "{{getName}}", content: "{{getContent}}" })
      }
    }
  }
  let callModelResult = get(key: "callModelResult")
}
