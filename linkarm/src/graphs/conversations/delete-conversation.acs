graph delete-conversation {
  meta: { description: "Delete a conversation by _convDelId from context menu", type: "core", input: "_convDelId, conversations, currentConversationId", output: "conversations, currentConversationId, _activeContext, _delCtx" }

  let getConvId = get(key: "_convDelId")
  let getConversations = get(key: "conversations")
  let getFilteredConvs = filter conv in getConversations {
    let getCurConvId = getProp(obj: "{{conv}}", key: "id")
    let compare = eq(a: "{{getCurConvId}}", b: "{{getConvId}}")
    let shouldKeep = not(value: "{{compare}}")
  }
  let updateStore = setGlobal(key: "conversations", value: "{{getFilteredConvs}}")
  let saveConversations = execFile(file: "conversations/save-conversations")
  let createDelCtx = createConversationContext(convId: "{{getConvId}}")
  let setDelCtx = setGlobal(key: "_delCtx", value: "{{createDelCtx}}")
  let deleteMessagesFile = executeInContext(contextKey: "_delCtx", graphKey: "__graph_messages/delete-messages")
  let checkCurrentConv = get(key: "currentConversationId")
  let isCurrentConvDeleted = eq(a: "{{checkCurrentConv}}", b: "{{getConvId}}")
  let handleCurrentConv = if isCurrentConvDeleted {
    let getFilteredLen = len(value: "{{getFilteredConvs}}")
    let checkHasMore = gt(a: "{{getFilteredLen}}", b: 0)
    let setNewCurrentConv = if checkHasMore {
      let getFirst = getProp(obj: "{{getFilteredConvs}}", key: 0)
      let getFirstId = getProp(obj: "{{getFirst}}", key: "id")
      let setCurrentId = setGlobal(key: "currentConversationId", value: "{{getFirstId}}")
      let createCtx = createConversationContext(convId: "{{getFirstId}}")
      let setActiveCtx = setGlobal(key: "_activeContext", value: "{{createCtx}}")
    } else {
      let clearCurrentId = setGlobal(key: "currentConversationId", value: null)
      let clearMessages = set(key: "messages", value: [])
      let createEmptyCtx = createConversationContext(convId: "__empty__")
      let setActiveCtx = setGlobal(key: "_activeContext", value: "{{createEmptyCtx}}")
    }
  }
  let updateSidebar = executeInContext(contextKey: "_activeContext", graphKey: "__graph_ui/layout/sidebar/create")
  let switchToChat = executeInContext(contextKey: "_activeContext", graphKey: "__graph_ui/views/chat/switch-view")
}