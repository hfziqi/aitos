graph save-growth {
  meta: { description: "Save a growth graph - compile, validate, register, persist, index, log", type: "tool", input: "name, acs", output: "createGrowthResult, createGrowthResult_success, createGrowthResult_error, createGrowthResult_path, __graph_*" }
  out: getResult

  let getName = get(key: "name")
  let getAcs = get(key: "acs")
  let checkName = isNil(value: "{{getName}}")
  let checkAcs = isNil(value: "{{getAcs}}")

  let execCheckLock = execFile(file: "growth/check-lock")
  let getLockResult = get(key: "checkLockResult")
  let isLocked = getProp(obj: "{{getLockResult}}", key: "locked")
  let handleLocked = if isLocked {
    let buildError = set(key: "_errorMsg", value: "growth '{{getName}}' is locked")
    let setError = set(key: "createGrowthResult", value: { success: false, error: "growth '{{getName}}' is locked" })
    let logFailure = execFile(file: "growth/log-growth-failure")
  }

  let validateInput = if isLocked {
    let skip = set(key: "_lockedSkip", value: true)
  } else {
    let doValidate = if checkName {
    let buildError = set(key: "_errorMsg", value: "Missing growth name")
    let setError = set(key: "createGrowthResult", value: { success: false, error: "{{_errorMsg}}" })
    let logFailure = execFile(file: "growth/log-growth-failure")
  } else {
    let validateAcs = if checkAcs {
      let buildError = set(key: "_errorMsg", value: "Missing ACS source code")
      let setError = set(key: "createGrowthResult", value: { success: false, error: "{{_errorMsg}}" })
      let logFailure = execFile(file: "growth/log-growth-failure")
    } else {
      let compile = compileAcs(acs: "{{getAcs}}")
      let compileFailed = isError(value: "{{compile}}")
      let compileOk = not(value: "{{compileFailed}}")
      let checkBodyRef = contains(text: "{{getAcs}}", search: "parentId: \"body\"")
      let handleBodyRef = if checkBodyRef {
        let buildError = set(key: "_errorMsg", value: "Growth cannot append directly to body. Use get(key: \"growthContainerId\") as parentId.")
        let setError = set(key: "createGrowthResult", value: { success: false, error: "{{_errorMsg}}" })
        let logFailure = execFile(file: "growth/log-growth-failure")
      }
      let isBodyClean = not(value: "{{checkBodyRef}}")
      let canSave = and(a: "{{compileOk}}", b: "{{isBodyClean}}")
      let handleCompile = if canSave {
      let graphMeta = getProp(obj: "{{compile}}", key: "_meta")
      let metaType = getProp(obj: "{{graphMeta}}", key: "type")
      let metaIcon = getProp(obj: "{{graphMeta}}", key: "icon")
      let metaDesc = getProp(obj: "{{graphMeta}}", key: "description")
      let metaTypeNil = isNil(value: "{{metaType}}")
      let metaIconNil = isNil(value: "{{metaIcon}}")
      let metaDescNil = isNil(value: "{{metaDesc}}")
        let resolvedType = if metaTypeNil {
          let t = concat(a: "tool", b: "")
        } else {
          let t = concat(a: "{{metaType}}", b: "")
        }
        let resolvedIcon = if metaIconNil {
          let i = concat(a: "🧩", b: "")
        } else {
          let i = concat(a: "{{metaIcon}}", b: "")
        }
        let resolvedDesc = if metaDescNil {
          let d = concat(a: "", b: "")
        } else {
          let d = concat(a: "{{metaDesc}}", b: "")
        }
        let storeKey = concat(a: "__graph_", b: "{{getName}}")
        let buildMeta = merge(a: "{{graphMeta}}", b: { type: "{{resolvedType}}", icon: "{{resolvedIcon}}", description: "{{resolvedDesc}}" })
        let buildFinalGraph = merge(a: "{{compile}}", b: { _meta: "{{buildMeta}}" })
        let register = set(key: "{{storeKey}}", value: "{{buildFinalGraph}}")
        let filePath = concat(a: "growths/", b: "{{getName}}")
        let isSubGraph = contains(text: "{{getName}}", search: "/")
        let filePathAcs = if isSubGraph {
          let subPath = concat(a: "{{filePath}}", b: ".acs")
        } else {
          let mainPath = concat(a: "{{filePath}}", b: "/main.acs")
        }
        let persist = writeLocal(key: "{{filePathAcs}}", value: "{{getAcs}}")
        let logSuccess = execFile(file: "growth/log-growth-success")
        let handleIndex = if isSubGraph {
          let skip = set(key: "_indexSkipped", value: true)
        } else {
          let updateIndex = execFile(file: "growth/update-growth-index")
        }
        let setResult = set(key: "createGrowthResult", value: { success: true, path: "{{filePathAcs}}", name: "{{getName}}" })
      } else {
        let handleCompileError = if not(value: "{{compileOk}}") {
          let buildError = set(key: "_errorMsg", value: "{{compile.__error}}")
          let setError = set(key: "createGrowthResult", value: { success: false, error: "{{compile.__error}}" })
          let logFailure = execFile(file: "growth/log-growth-failure")
        }
      }
    }
  }
    let getResult = get(key: "createGrowthResult")
    // Explicit data flow: split result object into dedicated keys at the producer
    let getResultSuccess = getProp(obj: "{{getResult}}", key: "success")
    let getResultError = getProp(obj: "{{getResult}}", key: "error")
    let getResultPath = getProp(obj: "{{getResult}}", key: "path")
    let setResultSuccess = set(key: "createGrowthResult_success", value: "{{getResultSuccess}}")
    let setResultError = set(key: "createGrowthResult_error", value: "{{getResultError}}")
    let setResultPath = set(key: "createGrowthResult_path", value: "{{getResultPath}}")
  }
}
