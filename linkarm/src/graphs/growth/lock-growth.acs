graph lock-growth {
  meta: { description: "Lock or unlock a growth — only callable via right-click menu, NOT in AI tools", type: "core", input: "name, locked", output: "lockGrowthResult, _growthIndex" }

  let getName = get(key: "name")
  let getLocked = get(key: "locked")
  // Read the growth index through the interface graph (list-growths), not the raw file
  let readIndex = execFile(file: "growth/list-growths")
  let indexIsArr = isArr(value: "{{readIndex}}")
  let initIndex = if indexIsArr {
    let keep = set(key: "_growthIndex", value: "{{readIndex}}")
  } else {
    let empty = set(key: "_growthIndex", value: [])
  }
  let getIndex = get(key: "_growthIndex")
  let rebuildIndex = map item in getIndex {
    let itemName = getProp(obj: "{{item}}", key: "name")
    let isTarget = eq(a: "{{itemName}}", b: "{{getName}}")
    let mappedItem = if isTarget {
      let updatedItem = setProp(obj: "{{item}}", key: "locked", value: {{getLocked}})
    } else {
      let originalItem = {{item}}
    }
  }
  // Write the growth index through the interface graph (save-growth-index), not the raw file
  let setIndexForSave = set(key: "growthsListResult", value: "{{rebuildIndex}}")
  let saveIndex = execFile(file: "growth/save-growth-index")
  let lockFilePath = concat(a: "growths/", b: "{{getName}}")
  let lockFileFull = concat(a: "{{lockFilePath}}", b: "/_lock")
  let lockFileContent = if getLocked {
    let writeLocked = writeLocal(key: "{{lockFileFull}}", value: "true")
  } else {
    let writeUnlocked = writeLocal(key: "{{lockFileFull}}", value: "false")
  }
  let setResult = set(key: "lockGrowthResult", value: { success: true, name: "{{getName}}", locked: {{getLocked}} })
}
