graph click-delegate {
  meta: { description: "Click event delegation - pure router", type: "core", input: "clickTargetId, ancestorIds", output: "routes to action graphs" }

  // Explicit data flow: consume the dedicated keys provided by event-loop
  let getTargetId = get(key: "clickTargetId")
  let getAncestorIds = get(key: "ancestorIds")
  let routeAction = if getTargetId {
    let isModelsTab = eq(a: "{{getTargetId}}", b: "modelsTab")
    let branchModelsTab = if isModelsTab {
      let execAction = execFile(file: "actions/click/tab-switch")
    }
    let isGrowthsTab = eq(a: "{{getTargetId}}", b: "growthsTab")
    let branchGrowthsTab = if isGrowthsTab {
      let execAction = execFile(file: "actions/click/tab-switch")
    }
    let isNewChat = eq(a: "{{getTargetId}}", b: "newChatButton")
    let branchNewChat = if isNewChat {
      let execAction = execFile(file: "actions/newChat")
    }
    let isChatBtn = eq(a: "{{getTargetId}}", b: "chatButton")
    let branchChatBtn = if isChatBtn {
      let execAction = execFile(file: "actions/openChat")
    }
    let isAIBtn = eq(a: "{{getTargetId}}", b: "aiButton")
    let branchAIBtn = if isAIBtn {
      let execAction = execFile(file: "models/open-market")
    }
    let isTerminalBtn = eq(a: "{{getTargetId}}", b: "terminalButton")
    let branchTerminalBtn = if isTerminalBtn {
      let execAction = execFile(file: "actions/open-terminal")
    }
    let isFolderBtn = eq(a: "{{getTargetId}}", b: "folderButton")
    let branchFolderBtn = if isFolderBtn {
      let execAction = execFile(file: "actions/open-folder")
    }
    let isSendBtn = eq(a: "{{getTargetId}}", b: "sendButton")
    let branchSendBtn = if isSendBtn {
      let execAction = execFile(file: "actions/send-message")
    }
    let isUploadBtn = eq(a: "{{getTargetId}}", b: "uploadBtn")
    let branchUploadBtn = if isUploadBtn {
      let execAction = execFile(file: "actions/handle-upload-click")
    }
    let isRemoveAttach = eq(a: "{{getTargetId}}", b: "removeAttachBtn")
    let branchRemoveAttach = if isRemoveAttach {
      let execAction = execFile(file: "actions/remove-attachment")
    }
    let isContextMenuAddModel = eq(a: "{{getTargetId}}", b: "contextMenuAddModel")
    let branchContextMenuAddModel = if isContextMenuAddModel {
      let execAction = execFile(file: "ui/components/context-menu/handle-add-model")
    }
    let isSubmitAddModelBtn = eq(a: "{{getTargetId}}", b: "submitAddModelButton")
    let branchSubmitAddModelBtn = if isSubmitAddModelBtn {
      let execAction = execFile(file: "models/submit-add-form")
    }
    let isCancelAddModelBtn = eq(a: "{{getTargetId}}", b: "cancelAddModelButton")
    let branchCancelAddModelBtn = if isCancelAddModelBtn {
      let execAction = execFile(file: "ui/components/add-model-form/hide")
    }
    let isAddModelOverlay = eq(a: "{{getTargetId}}", b: "addModelOverlay")
    let branchAddModelOverlay = if isAddModelOverlay {
      let execAction = execFile(file: "ui/components/add-model-form/hide")
    }
    let isContextMenuImport = eq(a: "{{getTargetId}}", b: "contextMenuImport")
    let branchContextMenuImport = if isContextMenuImport {
      let execAction = execFile(file: "ui/components/context-menu/handle-import")
    }
    let isContextMenuLockBtn = eq(a: "{{getTargetId}}", b: "contextMenuLockBtn")
    let branchContextMenuLockBtn = if isContextMenuLockBtn {
      let execAction = execFile(file: "ui/components/context-menu/handle-lock")
    }
    let isContextMenuUnlockBtn = eq(a: "{{getTargetId}}", b: "contextMenuUnlockBtn")
    let branchContextMenuUnlockBtn = if isContextMenuUnlockBtn {
      let execAction = execFile(file: "ui/components/context-menu/handle-lock")
    }
    let isContextMenuGrowthDelete = eq(a: "{{getTargetId}}", b: "contextMenuGrowthDelete")
    let branchContextMenuGrowthDelete = if isContextMenuGrowthDelete {
      let execAction = execFile(file: "ui/components/context-menu/handle-growth-delete")
    }
    let isContextMenuModelDelete = eq(a: "{{getTargetId}}", b: "contextMenuModelDelete")
    let branchContextMenuModelDelete = if isContextMenuModelDelete {
      let execAction = execFile(file: "ui/components/context-menu/handle-model-delete")
    }
    let isContextMenuOverlay = eq(a: "{{getTargetId}}", b: "contextMenuOverlay")
    let branchContextMenuOverlay = if isContextMenuOverlay {
      let execAction = execFile(file: "ui/components/context-menu/hide")
    }
    let isFolderCtxNewFolder = eq(a: "{{getTargetId}}", b: "folderCtxNewFolder")
    let branchFolderCtxNewFolder = if isFolderCtxNewFolder {
      let execAction = execFile(file: "ui/views/folder/handle-new-folder")
    }
    let isFolderCtxNewFile = eq(a: "{{getTargetId}}", b: "folderCtxNewFile")
    let branchFolderCtxNewFile = if isFolderCtxNewFile {
      let execAction = execFile(file: "ui/views/folder/handle-new-file")
    }
    let isFolderBack = eq(a: "{{getTargetId}}", b: "folderBackBtn")
    let branchFolderBack = if isFolderBack {
      let execAction = execFile(file: "ui/views/folder/handle-back")
    }
    let isFileViewClose = eq(a: "{{getTargetId}}", b: "fileViewClose")
    let branchFileViewClose = if isFileViewClose {
      let removeOverlay = removeElement(id: "fileViewOverlay")
    }
    let isFileViewOverlay = eq(a: "{{getTargetId}}", b: "fileViewOverlay")
    let branchFileViewOverlay = if isFileViewOverlay {
      let removeOverlay = removeElement(id: "fileViewOverlay")
    }
    let isFolderCtxOpen = eq(a: "{{getTargetId}}", b: "folderCtxOpen")
    let branchFolderCtxOpen = if isFolderCtxOpen {
      let hideMenu = execFile(file: "ui/components/context-menu/hide")
      let execDblClick = execFile(file: "ui/views/folder/handle-dblclick")
    }
    let isFolderCtxRename = eq(a: "{{getTargetId}}", b: "folderCtxRename")
    let branchFolderCtxRename = if isFolderCtxRename {
      let hideMenu = execFile(file: "ui/components/context-menu/hide")
      let execRename = execFile(file: "ui/views/folder/handle-rename")
    }
    let isFolderCtxDelete = eq(a: "{{getTargetId}}", b: "folderCtxDelete")
    let branchFolderCtxDelete = if isFolderCtxDelete {
      let hideMenu = execFile(file: "ui/components/context-menu/hide")
      let execDelete = execFile(file: "ui/views/folder/handle-delete")
    }
    let isFolderCtxUpload = eq(a: "{{getTargetId}}", b: "folderCtxUpload")
    let branchFolderCtxUpload = if isFolderCtxUpload {
      let execAction = execFile(file: "ui/views/folder/handle-upload")
    }
    let isImportStartBtn = eq(a: "{{getTargetId}}", b: "importPkgStartBtn")
    let branchImportStartBtn = if isImportStartBtn {
      let execAction = execFile(file: "growth/import-package")
    }
    let isImportCancelBtn = eq(a: "{{getTargetId}}", b: "importPkgCancelBtn")
    let branchImportCancelBtn = if isImportCancelBtn {
      let execAction = execFile(file: "ui/components/import-package-form/hide")
    }
    let isImportOverlay = eq(a: "{{getTargetId}}", b: "importPkgOverlay")
    let branchImportOverlay = if isImportOverlay {
      let execAction = execFile(file: "ui/components/import-package-form/hide")
    }
    let checkModelCard = if getTargetId {
      let getPrefix = slice(array: "{{getTargetId}}", start: 0, end: 11)
      let checkPrefix = eq(a: "{{getPrefix}}", b: "model_card_")
      let getSuffix = slice(array: "{{getTargetId}}", start: -7)
      let checkIsDelete = eq(a: "{{getSuffix}}", b: "_delete")
      let checkNotDelete = not(value: "{{checkIsDelete}}")
      let isModelCard = and(a: "{{checkPrefix}}", b: "{{checkNotDelete}}")
      let handleModelCardClick = if isModelCard {
        let execAction = execFile(file: "models/select-model")
      }
    }
    let isContextMenuConvDelete = eq(a: "{{getTargetId}}", b: "contextMenuConvDelete")
    let branchContextMenuConvDelete = if isContextMenuConvDelete {
      let execAction = execFile(file: "ui/components/context-menu/handle-conv-delete")
    }
    let isContextMenuConvRename = eq(a: "{{getTargetId}}", b: "contextMenuConvRename")
    let branchContextMenuConvRename = if isContextMenuConvRename {
      let execAction = execFile(file: "ui/components/context-menu/handle-conv-rename")
    }
    let checkConvItem = if getTargetId {
      let getPrefix = slice(array: "{{getTargetId}}", start: 0, end: 9)
      let checkPrefix = eq(a: "{{getPrefix}}", b: "convItem-")
      let handleConvItemClick = if checkPrefix {
        let execAction = execFile(file: "actions/switchConversation")
      }
    }
    let checkConvTitle = if getTargetId {
      let getPrefix = slice(array: "{{getTargetId}}", start: 0, end: 10)
      let checkPrefix = eq(a: "{{getPrefix}}", b: "convTitle-")
      let handleConvTitleClick = if checkPrefix {
        let execAction = execFile(file: "actions/switchConversation")
      }
    }
    let checkCopyBtn = if getTargetId {
      let getPrefix = slice(array: "{{getTargetId}}", start: 0, end: 8)
      let checkPrefix = eq(a: "{{getPrefix}}", b: "copyBtn_")
      let handleCopyClick = if checkPrefix {
        let execAction = execFile(file: "actions/copy-message")
      }
    }
    let checkGrowthCard = if getTargetId {
      let getPrefix = slice(array: "{{getTargetId}}", start: 0, end: 12)
      let checkPrefix = eq(a: "{{getPrefix}}", b: "growth_card_")
      let getSuffix = slice(array: "{{getTargetId}}", start: -7)
      let checkIsDelete = eq(a: "{{getSuffix}}", b: "_delete")
      let checkNotDelete = not(value: "{{checkIsDelete}}")
      let isGrowthCard = and(a: "{{checkPrefix}}", b: "{{checkNotDelete}}")
      let handleGrowthCardClick = if isGrowthCard {
        let execAction = execFile(file: "growth/open-growth")
      }
    }
    let checkGrowthOverlay = if getTargetId {
      let isOverlay = eq(a: "{{getTargetId}}", b: "growthOverlay")
      let handleOverlay = if isOverlay {
        let execAction = execFile(file: "ui/components/growth-popup/hide")
      }
    }
    let checkGrowthClose = if getTargetId {
      let isClose = eq(a: "{{getTargetId}}", b: "growthPopupClose")
      let handleClose = if isClose {
        let execAction = execFile(file: "ui/components/growth-popup/hide")
      }
    }
    let checkGrowthDetailClose = if getTargetId {
      let isClose = eq(a: "{{getTargetId}}", b: "growthDetailClose")
      let handleClose = if isClose {
        let execAction = execFile(file: "ui/components/growth-detail/hide")
      }
    }
    let checkGrowthDetailOverlay = if getTargetId {
      let isOverlay = eq(a: "{{getTargetId}}", b: "growthDetailOverlay")
      let handleOverlay = if isOverlay {
        let execAction = execFile(file: "ui/components/growth-detail/hide")
      }
    }
    let checkGrowthPopupClick = if getTargetId {
      let findContainer = closest(id: "{{getTargetId}}", selector: "#growthPopupBody")
      let isNilResult = isNil(value: "{{findContainer}}")
      let isInPopup = not(value: "{{isNilResult}}")
      let handleGrowthClick = if isInPopup {
        let execAction = execFile(file: "growth/handle-growth-click")
      }
    }
  }
}
