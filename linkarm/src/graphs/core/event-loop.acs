graph event-loop {
  meta: { description: "Event dispatch loop - polls appClick signal and routes to active conversation context", type: "core", input: "appClick_id, appClick_targetId, appClick_ancestorIds", output: "routes to click-delegate" }

  let eventLoop = loop {
    // Explicit data flow: use the _id signal (provided by addEventListener)
    // to detect a new event - no box object needed.
    let getEventId = get(key: "appClick_id")
    let checkEvent = isNil(value: "{{getEventId}}")
    let hasEvent = not(value: "{{checkEvent}}")
    let handleEvent = if hasEvent {
      let getTargetId = get(key: "appClick_targetId")
      let getAncestors = get(key: "appClick_ancestorIds")
      let execInCtx = executeInContext(
        contextKey: "_activeContext",
        graphKey: "__graph_core/click-delegate",
        store: { clickTargetId: "{{getTargetId}}", ancestorIds: "{{getAncestors}}" }
      )
      // Check whether a new event overwrote this one (compare _id signals)
      let getCurrentEventId = get(key: "appClick_id")
      let isSameEvent = eq(a: "{{getEventId}}", b: "{{getCurrentEventId}}")
      let clearIfSame = if isSameEvent {
        let clearEvent = set(key: "appClick", value: null)
        let clearEventId = set(key: "appClick_id", value: null)
      }
    }
    let yield = wait(ms: 50)
  }
}
